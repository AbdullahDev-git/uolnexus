# Get these from your Supabase project: Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Simple passcode for the /admin/memories page (not real auth)
VITE_ADMIN_PASSCODE=admin123

# Google Analytics 4 measurement ID (set in Vercel env vars, not committed)
VITE_GA_MEASUREMENT_ID=G-XXXXXXX

# EmailJS - Get from https://www.emailjs.com/ (Account > API Keys)
VITE_EMAILJS_PUBLIC_KEY=your-public-key
VITE_EMAILJS_SERVICE_ID=your-service-id
VITE_EMAILJS_TEMPLATE_ID=your-template-id
